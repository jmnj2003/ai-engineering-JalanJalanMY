<mxfile host="app.diagrams.net">
  <diagram id="jjmy-w3" name="JalanJalanMY V1 Data Pipeline">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;JalanJalanMY — Executed V1 Data Pipeline (Pathway A: PDF)&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ctx" value="Expands the Week 2 component &lt;b&gt;Source Ingestion &amp;amp; Fact Extraction&lt;/b&gt; (week2_architecture_v1.png): Official Tourism Sources → [this pipeline] → Knowledge Source" style="text;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#222222;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1080" height="32" as="geometry"/>
        </mxCell>

        <!-- Sources -->
        <mxCell id="s01" value="&lt;b&gt;SOURCE — S01&lt;/b&gt;&lt;br&gt;IDB_PDF_KLD_EN.pdf&lt;br&gt;Tourism Malaysia KL guide&lt;br&gt;72 pages · Mar 2025&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;FR3, RAI1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="170" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s02" value="&lt;b&gt;SOURCE — S02&lt;/b&gt;&lt;br&gt;Map_Guide_PENANG_Eng.pdf&lt;br&gt;2-page map guide · Mar 2024&lt;br&gt;&lt;i&gt;Inspected only&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="170" height="85" as="geometry"/>
        </mxCell>

        <!-- Stages -->
        <mxCell id="ing" value="&lt;b&gt;INGEST&lt;/b&gt;&lt;br&gt;select_source() /&lt;br&gt;resolve_source():&lt;br&gt;exact file in data/raw,&lt;br&gt;SHA-256 recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="160" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="insp" value="&lt;b&gt;INSPECT&lt;/b&gt;&lt;br&gt;pypdf text extraction:&lt;br&gt;pages, characters,&lt;br&gt;empty pages, samples&lt;br&gt;(72 pages · 143,605 chars)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="110" width="170" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="prep" value="&lt;b&gt;PREPARE / TRANSFORM&lt;/b&gt;&lt;br&gt;Whitespace cleanup →&lt;br&gt;paragraph-aware chunks,&lt;br&gt;500 characters&lt;br&gt;(303 chunks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="110" width="170" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="val" value="&lt;b&gt;VALIDATE OUTPUT&lt;/b&gt;&lt;br&gt;File exists, non-empty,&lt;br&gt;303 records, no empty&lt;br&gt;chunks, output SHA-256,&lt;br&gt;2 records checked by eye" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="890" y="110" width="170" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="lin" value="&lt;b&gt;RECORD LINEAGE&lt;/b&gt;&lt;br&gt;week3_manifest.json (Part B)&lt;br&gt;pipeline_manifest.json (Part C)&lt;br&gt;Verification PASS ·&lt;br&gt;Repeatability PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="110" width="180" height="95" as="geometry"/>
        </mxCell>

        <!-- Outputs -->
        <mxCell id="out" value="&lt;b&gt;Prepared outputs → Knowledge Source&lt;/b&gt;&lt;br&gt;data/processed/prepared_text.jsonl&lt;br&gt;data/pipeline_v1/documents/prepared_text.jsonl&lt;br&gt;(record_id, text, source, sha256, processing)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Next: embeddings / retrieval in later topics&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;spacingTop=22;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="270" width="290" height="130" as="geometry"/>
        </mxCell>

        <!-- Flow -->
        <mxCell id="e1" value="PDF" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="s01" target="ing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="file + hash" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="ing" target="insp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="raw text" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="insp" target="prep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="chunks" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="prep" target="val"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value=".jsonl" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="val" target="lin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="verified output" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="lin" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="inspected only:&lt;br&gt;map labels mixed in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s02" target="insp">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="492" y="342"/></Array></mxGeometry>
        </mxCell>

        <!-- Failure points -->
        <mxCell id="f1" value="&lt;b&gt;⚠ Failure point 1 — Inspect&lt;/b&gt;&lt;br&gt;Scanned or map-layout PDF gives empty or fragmented text (S02: 159 lines of map labels).&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; stop if text is empty (&quot;may require OCR&quot;); flag map-layout sources and keep them out of preparation until a layout-aware loader is added." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="395" width="360" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;⚠ Failure point 2 — Prepare&lt;/b&gt;&lt;br&gt;All 29 paragraph segments exceed 500 chars, so chunks cut through attraction entries (133 mid-word cuts) — name and description can end up in different chunks.&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; accepted for V1 and recorded; later split on attraction headings and keep page numbers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="255" width="330" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="fl1" style="html=1;endArrow=none;dashed=1;strokeColor=#b85450;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="insp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl2" style="html=1;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="f2" target="prep"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Requirement gap note -->
        <mxCell id="gap" value="&lt;b&gt;Data gap (not a pipeline failure):&lt;/b&gt; the guides have almost no opening hours or fees (8 time mentions, 1 price in S01), so NFR2/FR4 need an extra structured hours source — see week3_data_inventory.md." style="text;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1110" y="435" width="290" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend:&lt;/b&gt; Green = data source / prepared data | Blue = processing stage | Orange = validation | Purple = lineage | Red = failure point and response | Dashed = inspected only / annotation link. Numbers are from the executed notebook (notebooks/week3_pipeline.ipynb)." style="text;html=1;whiteSpace=wrap;fillColor=none;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;strokeColor=#999999;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="540" width="1380" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
